# Managed by Ansible.
passdb {
  driver = passwd-file
  args = scheme=SHA512-CRYPT username_format=%u {{ dovecot_virtual_auth_file }}
}

userdb {
  driver = passwd-file
  args = username_format=%u {{ dovecot_virtual_auth_file }}
  default_fields = uid={{ dovecot_virtual_user }} gid={{ dovecot_virtual_group }}
}
