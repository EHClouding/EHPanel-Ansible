# {{ ehagent_config_path }}
# Generated by Ansible. The agent may update node_id after enrollment.

[agent]
node_id = ""
hostname = "{{ ehagent_hostname }}"
enrollment_token = "{{ ehagent_enrollment_token }}"
version = "{{ ehagent_version }}"
log_level = "{{ ehagent_log_level }}"

[server]
url = "{{ ehagent_panel_url }}"
reconnect_interval_s = 5
ping_interval_s = {{ ehagent_heartbeat_interval }}

[security]
agent_secret = ""
hmac_key = ""
key_file = "{{ ehagent_keypair_path }}"

[telemetry]
push_interval_s = {{ ehagent_telemetry_interval }}
