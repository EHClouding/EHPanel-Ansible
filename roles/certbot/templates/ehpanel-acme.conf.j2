# Managed by Ansible.
server {
    listen 80;
    listen [::]:80;
    server_name {{ ([item.domain] + (item.aliases | default([]))) | join(' ') }};

    location ^~ /.well-known/acme-challenge/ {
        root {{ item.webroot | default(certbot_webroot_path) }};
        default_type text/plain;
        try_files $uri =404;
    }

    location = /ehpanel-node-status {
        alias /usr/share/nginx/html/ehpanel-node-status.html;
        default_type text/html;
    }

    location = /ehpanel-apache-status {
        proxy_pass http://127.0.0.1:8080/ehpanel-apache-status.html;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /ehpanel-php-status {
        proxy_pass http://127.0.0.1:8080/ehpanel-php-status.php;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /ehpanel-dbtools/ {
        proxy_pass http://127.0.0.1:8080/ehpanel-dbtools/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
