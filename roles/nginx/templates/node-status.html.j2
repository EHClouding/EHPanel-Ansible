<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>EHPanel Web Node</title>
  <style>
    body { margin: 0; font-family: Arial, sans-serif; background: #0b1020; color: #e8edf7; display: grid; place-items: center; min-height: 100vh; }
    main { border: 1px solid #27324d; border-radius: 8px; padding: 24px; background: #121a2e; min-width: 320px; }
    h1 { margin: 0 0 12px; font-size: 22px; }
    p { margin: 8px 0; color: #9aa7bd; }
    b { color: #29d391; }
  </style>
</head>
<body>
  <main>
    <h1>EHPanel Web Node</h1>
    <p>Host: <b>{{ inventory_hostname }}</b></p>
    <p>Managed by Ansible: <b>yes</b></p>
    <p>Nginx: <b>active</b></p>
  </main>
</body>
</html>
